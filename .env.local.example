# Local account-system integration.
# Copy this file to .env.local when fries-cup-system API is running locally.
VITE_PLATFORM_API_BASE_URL=/api/platform
VITE_PLATFORM_API_PROXY_TARGET=http://127.0.0.1:4400
VITE_SYSTEM_APP_URL=http://127.0.0.1:5200

# Optional: point public season data to a local admin API as well.
# VITE_ADMIN_PUBLIC_PROXY_TARGET=http://127.0.0.1:4400

# Optional lightweight private-share links for the scouting report.
# This hides the entry behind an opaque URL; it is not account authentication.
# VITE_SCOUTING_ACCESS_KEYS=fcr26-club-<random-key>=Club access
