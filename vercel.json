{
  "env": { "ACCOUNT_API_ORIGIN": "https://test-admin.fries-cup.com", "ACCOUNT_PROXY_DIAGNOSTICS": "true" },
  "functions": { "api/account.js": { "regions": ["sin1"], "maxDuration": 15 } },
  "buildCommand": "npm run build:locales && npm run build:team-logo-catalog && npm run build:scouting-artifacts && node scripts/buildAccountJointCandidate.mjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/scouting/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/platform/auth/:path*",
      "destination": "/api/account?accountPath=auth/:path*"
    },
    {
      "source": "/api/platform/me/:path*",
      "destination": "/api/account?accountPath=me/:path*"
    },
    {
      "source": "/api/admin-public/:path*",
      "destination": "https://test-admin.fries-cup.com/api/public/:path*"
    },
    {
      "source": "/api/platform/:path*",
      "destination": "https://test-admin.fries-cup.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
